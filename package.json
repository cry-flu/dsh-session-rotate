{
  "name": "dsh-session-rotate",
  "version": "1.4.2",
  "description": "DSH 插件：会话步数到上限时，在轮末自动开新会话、投递本地拼装的交接摘要，并按开关归档/延迟归档旧会话、决定是否跳转到新会话（按工作区配置上限，零模型调用）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-rotate",
    "handoff",
    "context",
    "token-saving"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cry-flu/dsh-session-rotate.git"
  },
  "bugs": {
    "url": "https://github.com/cry-flu/dsh-session-rotate/issues"
  },
  "homepage": "https://cry-flu.github.io/dsh-session-rotate/",
  "author": "YG",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
